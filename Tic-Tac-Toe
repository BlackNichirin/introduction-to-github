import numpy as np
import random

board = np.zeros((3, 3), dtype=int)
moves = [(a, b) for a in range(3) for b in range(3)]
random.shuffle(moves)

player = 1
for move in moves:
    board[move[0]][move[1]] = player
    print(f"Board after move:")
    print(board)
    print()
    for a in range(3):
        if all(board[a, :] == player) or all(board[:, a] == player):
            print(f"Winner is: {player}")
            exit()
    if all(np.diag(board) == player) or all(np.diag(np.fliplr(board)) == player):
        print(f"Winner is: {player}")
        exit()
    player = 1 if player == 2 else 2

print("It's a Tie!")
